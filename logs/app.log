CREATE TABLE payments (
	id INTEGER NOT NULL, 
	transaction_id INTEGER NOT NULL, 
	amount FLOAT NOT NULL, 
	currency VARCHAR(10), 
	status VARCHAR(50), 
	provider VARCHAR(50) NOT NULL, 
	provider_payment_id VARCHAR(255), 
	created_at DATETIME, 
	updated_at DATETIME, 
	PRIMARY KEY (id), 
	FOREIGN KEY(transaction_id) REFERENCES transactions (id)
)


